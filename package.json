{
  "name": "@vacum972/dsh-usage-billing",
  "version": "0.1.0",
  "description": "DSH Web 用量与计费插件：输入框下方实时显示本会话消费、剩余余额、API 请求次数与 Tokens，并按官方高峰/空闲时段价目逐次请求计价。",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "vacum972",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vacum972/dsh-usage-billing.git"
  },
  "homepage": "https://github.com/vacum972/dsh-usage-billing#readme",
  "bugs": {
    "url": "https://github.com/vacum972/dsh-usage-billing/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "billing",
    "cost",
    "tokens",
    "balance"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg",
    "assets/screenshots/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
